# ---- IntelliHub environment ----
# Phase 1 runs fully on SEEDED data with no external deps.
DATA_SOURCE=seed

# Access provisioning workflow engine: local | appsheet
ACCESS_PROVIDER=local

# --- AppSheet (access workflow provider) ---
# APPSHEET_APP_ID=
# APPSHEET_API_KEY=
# Shared secret for the inbound status webhook (x-intellihub-signature header).
# Required in production; when unset, the webhook is open in dev only.
# APPSHEET_WEBHOOK_SECRET=

# --- BigQuery (interim metadata store) ---
# GOOGLE_CLOUD_PROJECT=
# BIGQUERY_DATASET=intellihub_data_inventory
# GOOGLE_APPLICATION_CREDENTIALS=

# --- OIDC / Enterprise SSO ---
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# AUTH_SECRET=

# --- DataHub (deep-link target; button disabled in Phase 1) ---
NEXT_PUBLIC_DATAHUB_BASE_URL=https://datahub.nai.io
NEXT_PUBLIC_DATAHUB_ORG=nai
